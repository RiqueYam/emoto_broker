---
import LiveIcon from './LiveIcon.astro';

interface Props {
  href: string;
  codigo: string;
  titulo: string;
  source: 'card' | 'selecao';
}
const { href, codigo, titulo, source } = Astro.props;
---

<a
  class="btn wa-btn"
  href={href}
  target="_blank"
  rel="noopener"
  aria-label={`Consultar no WhatsApp sobre ${titulo}, código ${codigo}`}
  data-track="wa_click"
  data-source={source}
  data-codigo={codigo}
>
  <span class="wa-btn__disc">
    <LiveIcon name="message-circle" />
  </span>
  Consultar no WhatsApp
</a>
