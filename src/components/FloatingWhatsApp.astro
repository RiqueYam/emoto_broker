---
import LiveIcon from './LiveIcon.astro';
import { genericWaUrl } from '../lib/whatsapp';
---

<a
  class="wa-float"
  href={genericWaUrl}
  target="_blank"
  rel="noreferrer"
  aria-label="Falar no WhatsApp"
  data-track="wa_click"
  data-source="floating"
>
  <LiveIcon name="message-circle" />
</a>
