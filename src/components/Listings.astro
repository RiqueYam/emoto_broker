---
import PropertyCard from './PropertyCard.astro';
import { TABS, tabCounts, tabSlug, type ListingView } from '../lib/listings';

interface Props {
  listings: ListingView[];
}
const { listings } = Astro.props;
const counts = tabCounts(listings);
const countsBySlug = Object.fromEntries(TABS.map((t) => [tabSlug(t), counts[t]]));
---

<!--
  Tabs and Ver mais are driven by the plain script in src/scripts/listings.ts
  (the CLAUDE.md fallback for Alpine). Without JavaScript every card shows and the
  counter and button stay hidden.
-->
<main class="hairline-top" id="listings" data-counts={JSON.stringify(countsBySlug)}>
  <div class="container listings__head">
    <h2 class="section-title" id="todos-os-imoveis">
      Todos os imóveis
    </h2>
    <p class="helper-line">Selecione um imóvel para conhecer todos os detalhes.</p>
  </div>

  <div class="container type-tabs" role="group" aria-label="Filtrar imóveis por tipo e região">
    {TABS.map((t) => (
      <button
        type="button"
        class="btn pill type-tab"
        aria-pressed={t === 'Todos' ? 'true' : 'false'}
        data-tab={tabSlug(t)}
      >
        {t} ({counts[t]})
      </button>
    ))}
  </div>

  <section class="container listing-grid" id="lista-imoveis" aria-labelledby="todos-os-imoveis">
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 gy-5 gy-md-6" id="listing-grid">
      {listings.map((l) => (
        <div
          class="col card-col"
          data-tipo={tabSlug(l.tipo)}
          data-i={l.index}
          data-ti={l.tabIndex}
          data-pre-m={l.index >= 6 ? '' : undefined}
          data-pre-d={l.index >= 9 ? '' : undefined}
        >
          <PropertyCard listing={l} />
        </div>
      ))}
    </div>
  </section>

  <div class="container more" id="listings-more" hidden>
    <span class="more__count" aria-live="polite"></span>
    <button type="button" class="btn pill more__btn" aria-controls="lista-imoveis">
      Ver mais imóveis
    </button>
  </div>
</main>

<script>
  import '../scripts/listings';
</script>
