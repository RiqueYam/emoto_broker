---
/**
 * A live-page icon referenced from the sprite in IconSprite.astro, so the 48 cards
 * don't each repeat the paths. Size and colour come from CSS (currentColor).
 */
import type { LiveIconName } from '../lib/icons';

interface Props {
  name: LiveIconName;
  class?: string;
}
const { name, class: className } = Astro.props;
---

<svg
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  <use href={`#i-${name}`}></use>
</svg>
