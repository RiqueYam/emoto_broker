---
import LiveIcon from './LiveIcon.astro';
import { genericWaUrl } from '../lib/whatsapp';
import { INSTAGRAM_URL } from '../lib/site';
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <p class="site-footer__name">Edu Soares <span>|</span> Private Broker</p>
    <p class="site-footer__sub">Corretor associado à Coelho da Fonseca</p>
    <p class="site-footer__about">Atendimento personalizado no mercado imobiliário de alto padrão.</p>
    <div class="site-footer__links">
      <a
        href={genericWaUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-track="wa_click"
        data-source="footer"
        ><LiveIcon name="message-circle" />WhatsApp</a
      >
      <a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer"><LiveIcon name="instagram" />Instagram</a>
    </div>
    <p class="site-footer__creci">CRECI: 310960</p>
  </div>
</footer>
