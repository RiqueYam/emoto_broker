---
import LiveIcon from './LiveIcon.astro';
import { HERO_SIZES, type HeroImage } from '../lib/hero';
import { BROKER } from '../lib/site';

interface Props {
  /** null → placeholder panel (no image chosen yet in HERO, src/lib/site.ts) */
  image: HeroImage | null;
}
const { image } = Astro.props;
---

<header class="hero">
  <figure class="hero__figure">
    {image ? (
      <picture>
        <source type="image/avif" srcset={image.avif} sizes={HERO_SIZES} />
        <source type="image/webp" srcset={image.webp} sizes={HERO_SIZES} />
        <img
          class="hero__img"
          src={image.fallback}
          alt={image.alt}
          width={image.width}
          height={image.height}
          style={`object-position: ${image.position}`}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
    ) : (
      <div class="hero__img hero__img--placeholder" />
    )}
    <div class="hero__fade" aria-hidden="true"></div>
    <figcaption class="visually-hidden">
      {BROKER.name} · CRECI: {BROKER.creci}
    </figcaption>
  </figure>
  <div class="container hero__block">
    <p class="hero__name">{BROKER.name.toUpperCase()}</p>
    <p class="eyebrow hero__role">Private Broker</p>
    <p class="coelho-pill">
      <LiveIcon name="badge-check" />
      Corretora associada à Coelho da Fonseca
    </p>
    <div class="divider"></div>
    <h1 class="hero__title">
      Imóveis Selecionados
      <span class="visually-hidden">— Imóveis de alto padrão à venda em São Paulo e Alphaville</span>
    </h1>
    <p class="hero__intro">
      Uma curadoria de imóveis exclusivos em São Paulo. Explore as oportunidades e descubra seu próximo
      endereço.
    </p>
  </div>
</header>
