---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Selecao from '../components/Selecao.astro';
import Listings from '../components/Listings.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import { featured, loadListings } from '../lib/listings';
import { portraitSources } from '../lib/portrait';

const all = await loadListings();
const portrait = await portraitSources();
---

<Base portraitAvif={portrait.avif}>
  <div class="page">
    <Hero portrait={portrait} />
    <Selecao items={featured(all)} />
    <Listings listings={all} />
    <Footer />
  </div>
  <FloatingWhatsApp />
</Base>
